# Supabase Postgres connection string. In the Supabase dashboard click
# "Connect" (top bar) → "Connection string" → copy the **Transaction pooler**
# URI (port 6543; works over IPv4 and on Vercel) and put your database
# password in place of [YOUR-PASSWORD]. Then run `npm run db:setup`.
# A local Postgres works too: postgres://postgres:postgres@localhost:5432/devlog
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Optional Redis cache (Upstash). Leave empty to run without a cache.
# Create a database at https://console.upstash.com (region: same as Supabase)
# and copy its REST URL + token. On Vercel, the Upstash integration sets
# KV_REST_API_URL / KV_REST_API_TOKEN instead, which also work.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Long random string used to sign JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-a-long-random-string

# Public base URL of the app (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Email (OTP codes for sign-up verification + password reset) ----
# Any SMTP provider works. Gmail: enable 2-Step Verification, then create an
# App Password at https://myaccount.google.com/apppasswords and use it below.
# If SMTP_HOST/SMTP_USER/SMTP_PASS are empty in development, codes are printed
# in the terminal running `npm run dev` instead of being emailed.
# In production they are REQUIRED.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password
EMAIL_FROM="DevLog <you@gmail.com>"
